<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pure C#: no Godot dependency, so everything here is testable with plain xUnit. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Pipit.Core</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- SoundFont synthesizer in pure C# (MIT): natural recorder voice and accompaniment. -->
    <PackageReference Include="MeltySynth" Version="2.4.1" />
  </ItemGroup>
</Project>
